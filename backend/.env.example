# Copy this file to .env and change what you need. Never commit .env.

# Where JSON price files and the SQLite database live.
PP_DATA_DIR=./data
# Leave empty for SQLite in PP_DATA_DIR. For Postgres later:
# PP_DATABASE_URL=postgresql+psycopg://user:password@host:5432/pricepulse
PP_DATABASE_URL=

# Web addresses allowed to call the API from a browser (comma separated).
# Add your Firebase address, e.g. https://pricepulse-za.web.app
PP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public API limit per phone/computer (IP address) per minute.
PP_RATE_LIMIT_PER_MIN=60
# Set to 1 when the API runs behind a hosting proxy (Render, Railway, nginx).
PP_TRUST_PROXY=0
# Seconds browsers may cache API answers.
PP_CACHE_MAX_AGE=300

# Matching: names scoring at least AUTO are merged automatically; between
# REVIEW and AUTO they go to the review queue (python admin.py review).
PP_MATCH_AUTO=88
PP_MATCH_REVIEW=70

# Prices older than this many hours are marked "Old price" in the app.
PP_STALE_HOURS=48
# /api/v1/health?strict=1 returns an error when no scrape succeeded for this long.
PP_ALERT_HOURS=24

# --- Accounts, limits and payments -------------------------------------------------

# The app's public address (used for PayFast return and notice addresses).
PP_PUBLIC_URL=https://prices.example.co.za

# Sign-in uses TrolleyUp's Firebase project. Change only if you move to another project.
PP_FIREBASE_PROJECT=trolleyup-eff50

# SECRET. Scrambles ID numbers into fingerprints. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set it ONCE and never change or lose it: changing it lets every ID number be used
# for a second account. Keep a copy somewhere safe.
PP_ID_SECRET=

# Limits.
PP_SESSION_ITEMS=45
PP_FREE_SESSIONS=3
# Monthly price in cents (9900 = R99).
PP_PRICE_CENTS=9900

# PayFast (see docs/PAYMENTS.md). Leave the ID empty to keep payments switched off:
# the app then shows "Paid plans open soon".
PP_PAYFAST_MERCHANT_ID=
PP_PAYFAST_MERCHANT_KEY=
# SECRET. The passphrase you set in your PayFast account.
PP_PAYFAST_PASSPHRASE=
# 1 = PayFast's test system (no real money). 0 = live.
PP_PAYFAST_SANDBOX=1
# 1 = ask PayFast to confirm every payment notice. Keep at 1.
PP_PAYFAST_VALIDATE=1

# FOR LOCAL TESTING ONLY. Both must stay 0 on a public server
# (the Docker image refuses to start if either is 1).
PP_AUTH_DEV=0
PP_OPEN_PRICES=0

# Scheduler (scraper container).
PP_SCRAPE_EVERY_HOURS=6
PP_SCRAPE_REGIONS=paarl
# Optional: use an already-installed Chromium instead of Playwright's own.
# PP_CHROMIUM_PATH=/usr/bin/chromium
