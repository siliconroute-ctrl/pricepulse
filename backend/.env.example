# Copy this file to .env and change what you need. Never commit .env.

# Where JSON price files and the SQLite database live.
PP_DATA_DIR=./data
# Leave empty for SQLite in PP_DATA_DIR. For Postgres later:
# PP_DATABASE_URL=postgresql+psycopg://user:password@host:5432/pricepulse
PP_DATABASE_URL=

# Web addresses allowed to call the API from a browser (comma separated).
# Add your Firebase address, e.g. https://pricepulse-za.web.app
PP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public API limit per phone/computer (IP address) per minute.
PP_RATE_LIMIT_PER_MIN=60
# Set to 1 when the API runs behind a hosting proxy (Render, Railway, nginx).
PP_TRUST_PROXY=0
# Seconds browsers may cache API answers.
PP_CACHE_MAX_AGE=300

# Matching: names scoring at least AUTO are merged automatically; between
# REVIEW and AUTO they go to the review queue (python admin.py review).
PP_MATCH_AUTO=88
PP_MATCH_REVIEW=70

# Prices older than this many hours are marked "Old price" in the app.
PP_STALE_HOURS=48
# /api/v1/health?strict=1 returns an error when no scrape succeeded for this long.
PP_ALERT_HOURS=24

# Scheduler (scraper container).
PP_SCRAPE_EVERY_HOURS=6
PP_SCRAPE_REGIONS=paarl
# Optional: use an already-installed Chromium instead of Playwright's own.
# PP_CHROMIUM_PATH=/usr/bin/chromium
