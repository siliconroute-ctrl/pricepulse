# PricePulse scraper + scheduler. Playwright installs a matching Chromium and its libraries.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PP_DATA_DIR=/data
WORKDIR /app/backend
COPY backend/requirements.txt backend/requirements-scraper.txt ./
RUN pip install --no-cache-dir -r requirements-scraper.txt \
 && python -m playwright install --with-deps chromium
COPY backend/ /app/backend/
RUN mkdir -p /data
CMD ["python", "scheduler.py"]
